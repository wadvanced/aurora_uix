{
  "permissions": {
    "allow": [
      "Skill(address-pr-review)",
      "Skill(bump-dependencies)",
      "Skill(code-issue)",
      "Skill(do-pr)",
      "Skill(documentation)",
      "Skill(gate)",
      "Skill(gate-commit)",
      "Skill(gate-fix)",
      "Skill(improve-issue)",
      "Skill(merge-pr)",
      "Skill(orchestrate-issue)",
      "Skill(pr-from-issue)",
      "Skill(review-issue)",
      "Skill(spec-load)",
      "Skill(spec-store)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "files=$(git diff --name-only --diff-filter=ACM | grep -E '\\.(ex|exs|heex)$' | tr '\\n' ' '); if [ -n \"$files\" ]; then mix format $files 2>/dev/null; fi; true" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "if [ \"$(git branch --show-current)\" = \"main\" ]; then echo 'WARNING: on main - create a feature branch before committing'; fi" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-long-commands.sh" }
        ]
      }
    ]
  }
}
