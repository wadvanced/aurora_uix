# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# The developer and test configuration
/config/test.exs
/config/dev.exs

# Icons and stylesheet.css, they are generated
/assets/css/auix-*.css

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
aurora_uix-*.tar

# Temporary files, for example, from tests.
/tmp/

# idea
/.idea

*.iml

# Ignore assets that are produced by build tools.
/priv/static/assets/

# Ignore digested assets cache.
/priv/static/cache_manifest.json

# generated stuff
/priv/**/*.gz
/priv/static/classes-*.js
/priv/static/images/aurora_ctx-transparent-icon-*.svg
/priv/static/images/aurora_irix-transparent-icon-*.svg
/priv/static/images/aurora_uix-transparent-icon-*.svg
/priv/static/images/aurora_zelox-transparent-icon-*.svg
/priv/static/images/aurora-transparent-icon-*.svg
/priv/static/favicon-*.ico
/priv/static/robots-*.txt
/priv/static/css/auix-bridge-daisyui*.*


/tailwindcss-*.log

# vscode
/.vscode

/**/-local-*.*
/**/-local-*.*

/**/.expert/

# epic-orchestrator section worktrees — local only, never committed.
# Also covered by .git/info/exclude, but that file is per-clone: without this
# entry another checkout would sweep whole worktrees, _build included, into
# the gate-receipt tree hash.
/.claude/worktrees/

# epic-orchestrator run ledger and gate receipt — local only, never committed
/.orchestrator-state.json
/.test-receipt.json
